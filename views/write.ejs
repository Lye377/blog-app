<%- include('partials/header', { title: '写文章' }) %>

<h1>写文章</h1>
<% if (error) { %>
  <p class="error"><%= error %></p>
<% } %>
<form action="/posts/write" method="POST">
  <div>
    <label>标题：</label>
    <input type="text" name="title" required style="width: 300px;">
  </div>
  <div>
    <label>正文：</label><br>
    <textarea name="content" required rows="15" cols="60"></textarea>
  </div>
  <button type="submit">发布</button>
</form>

<%- include('partials/footer') %>
