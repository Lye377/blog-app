<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <title>登录</title>
</head>
<body>
  <h1>登录</h1>
  <% if (error) { %>
    <p style="color: red;"><%= error %></p>
  <% } %>
  <form action="/login" method="POST">
    <div>
      <label>用户名：</label>
      <input type="text" name="username" required>
    </div>
    <div>
      <label>密码：</label>
      <input type="password" name="password" required>
    </div>
    <button type="submit">登录</button>
  </form>
  <p>没有账号？<a href="/register">注册</a></p>
</body>
</html>