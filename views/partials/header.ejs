<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : "Lye's Blog" %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header>
    <nav>
      <a href="/">🏠 首页</a>
      <% if (typeof user !== 'undefined' && user) { %>
        <a href="/posts/write">✍️ 写文章</a>
        <a href="/stats">📊 统计</a>
      <% } %>
      <a href="/games/minesweeper">💣 扫雷</a>
      <a href="/chat">💬 对话闲人</a>
    </nav>
    <div>
      <% if (typeof user !== 'undefined' && user) { %>
        你好，<%= user.username %> | <a href="/logout">退出</a>
      <% } else { %>
        <a href="/login">登录</a> | <a href="/register">注册</a>
      <% } %>
    </div>
  </header>
  <hr>
