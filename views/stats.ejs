<%- include('partials/header', { title: title }) %>

<style>
  .stat-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 220px)); gap: 12px; margin: 24px 0 36px; }
  .stat-card { padding: 20px; border: 1px solid var(--line); border-radius: 16px; background: var(--paper); }
  .stat-label { color: var(--muted); font: 700 11px/1.4 "SFMono-Regular", Consolas, monospace; letter-spacing: .08em; }
  .stat-value { margin-top: 8px; color: var(--blue); font-family: "Songti SC", serif; font-size: 44px; font-weight: 800; line-height: 1; }
  .chart-panel { max-width: 820px; padding: 24px; border: 1px solid var(--line); border-radius: 18px; background: var(--paper); }
  @media (max-width: 480px) { .stat-grid { grid-template-columns: 1fr 1fr; } }
</style>

<p class="eyebrow">READING SIGNALS</p>
<h1>阅读统计</h1>
<p class="page-intro">看看哪些文字被读到。数字只是路标，不是写作的方向。</p>

<% if (postCount === 0) { %>
  <p class="empty-state">还没有可展示的阅读数据。</p>
<% } else { %>
  <div class="stat-grid">
    <div class="stat-card">
      <div class="stat-label">TOTAL READS</div>
      <div class="stat-value"><%= totalViews %></div>
    </div>
    <div class="stat-card">
      <div class="stat-label">ENTRIES</div>
      <div class="stat-value"><%= postCount %></div>
    </div>
  </div>

  <div class="chart-panel">
    <canvas id="viewsChart" height="240"></canvas>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script>
    // 后端把统计数据用不转义标签序列化成 JSON 注入前端，保证是合法 JS 数组
    var statsData = <%- JSON.stringify(stats) %>;
    var labels = statsData.map(function (s) { return s.title; });
    var counts = statsData.map(function (s) { return s.view_count || 0; });

    new Chart(document.getElementById('viewsChart'), {
      type: 'bar',
      data: {
        labels: labels,
        datasets: [{
          label: '阅读次数',
          data: counts,
          backgroundColor: '#1457d9',
          borderRadius: 7
        }]
      },
      options: {
        responsive: true,
        plugins: { legend: { display: false } },
        scales: {
          x: { grid: { display: false } },
          y: { beginAtZero: true, ticks: { precision: 0 }, grid: { color: '#e0e7f0' } }
        }
      }
    });
  </script>
<% } %>

<%- include('partials/footer') %>
