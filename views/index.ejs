<%- include('partials/header', { title: "Lye's Blog" }) %>

<h1>欢迎来到闲人Lye忙时候</h1>

<h2>文章列表</h2>
<% if (posts && posts.length > 0) { %>
  <% posts.forEach(function(post) { %>
    <div class="post-card">
      <h3><a href="/posts/<%= post.id %>"><%= post.title %></a></h3>
      <p class="post-meta">作者：<%= post.username %> | <%= post.created_at %> | 阅读：<%= post.view_count || 0 %></p>
    </div>
  <% }); %>
<% } else { %>
  <p>暂无文章。</p>
<% } %>

<%- include('partials/footer') %>
