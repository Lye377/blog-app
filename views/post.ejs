<%- include('partials/header', { title: post.title }) %>

<header class="article-header">
  <p class="eyebrow">FIELD NOTE · <%= post.view_count || 0 %> READS</p>
  <h1><%= post.title %></h1>
  <p class="post-meta">
    BY <%= post.username %> · <%= post.created_at %>
    <% if (post.updated_at && post.updated_at !== post.created_at) { %>
      · UPDATED <%= post.updated_at %>
    <% } %>
  </p>
  <div class="article-actions">
    <button id="like-btn" data-liked="<%= isLiked %>">
      <%= isLiked ? '取消点赞' : '喜欢这篇' %>
    </button>
    <span class="like-count">♥ <span id="like-count"><%= likeCount %></span></span>
  </div>
</header>

<article class="article-body"><%= post.content %></article>
<% if (user && user.id === post.user_id) { %>
  <div class="article-actions">
    <a href="/posts/<%= post.id %>/edit">编辑</a>
    <form action="/posts/<%= post.id %>/delete" method="POST" style="display: inline;" onsubmit="return confirm('确定删除？');">
      <button class="danger-button" type="submit">删除</button>
    </form>
  </div>
<% } %>

<hr>

<!-- 评论区域 -->
<h2>评论（<%= comments.length %>）</h2>
<% if (comments.length === 0) { %>
    <p class="page-intro">还没有评论。写下第一条回应吧。</p>
<% } else { %>
  <ul class="comment-list">
    <% comments.forEach(function (comment) { %>
      <li>
        <strong><%= comment.username %></strong>
        <span class="comment-time"><%= comment.created_at %></span>
        <p style="margin: 4px 0;"><%= comment.content %></p>
      </li>
    <% }); %>
  </ul>
<% } %>

<!-- 评论表单 -->
<% if (user) { %>
  <form action="/posts/<%= post.id %>/comment" method="POST">
    <p>
      <textarea name="content" rows="3" cols="50" placeholder="写下你的评论..." required></textarea>
    </p>
    <button type="submit">发表评论</button>
  </form>
<% } else { %>
  <p><a href="/login">登录</a> 后即可评论</p>
<% } %>

<script>
  (function () {
    var btn = document.getElementById('like-btn');
    if (!btn) return;
    btn.addEventListener('click', function () {
      fetch('/posts/<%= post.id %>/like', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
      })
        .then(function (res) {
          if (res.status === 401) {
            window.location.href = '/login';
            return null;
          }
          return res.json();
        })
        .then(function (data) {
          if (!data) return;
          document.getElementById('like-count').textContent = data.count;
          btn.dataset.liked = data.liked;
          btn.textContent = data.liked ? '取消点赞' : '喜欢这篇';
        })
        .catch(function (err) {
          console.error('点赞失败', err);
        });
    });
  })();
</script>

<%- include('partials/footer') %>
