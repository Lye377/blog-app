<%- include('partials/header', { title: title }) %>

<p class="eyebrow">PRIVATE CONNECTION</p>
<h1>API Key 设置</h1>

<% if (saved) { %>
  <p class="success">已保存。</p>
<% } %>

<p class="page-intro">
  请输入你的 DeepSeek API Key（前往
  <a href="https://platform.deepseek.com" target="_blank" rel="noopener">platform.deepseek.com</a>
  获取），Key 仅保存在你自己的账户中，不会展示给其他人。
</p>

<p class="post-meta">FREE MESSAGES REMAINING · <strong><%= freeChatCount %></strong></p>

<% if (hasKey) { %>
  <p>已保存的 Key：<code><%= maskedKey %></code>（只显示后 4 位）</p>
<% } %>

<form action="/settings" method="POST">
  <div>
    <label>DeepSeek API Key</label>
    <input type="password" name="api_key" placeholder="sk-..." autocomplete="off">
  </div>
  <p style="color: #aaa; font-size: 13px;">留空并保存即可清除已存的 Key。</p>
  <button type="submit">保存</button>
</form>

<p style="margin-top: 16px;"><a href="/chat">← 返回聊天</a></p>

<%- include('partials/footer') %>
