<%- include('partials/header', { title: title }) %>

<style>
  #chat-box {
    max-width: 760px;
    height: 500px;
    overflow-y: auto;
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: 22px;
    background: rgba(249, 251, 253, .78);
    box-shadow: var(--shadow);
  }
  .msg-row { display: flex; margin-bottom: 16px; }
  .msg-row.user { justify-content: flex-end; }
  .msg-row.ai { justify-content: flex-start; }
  .bubble {
    max-width: 76%;
    padding: 11px 15px;
    border: 1px solid var(--line);
    border-radius: 6px 16px 16px 16px;
    line-height: 1.65;
    white-space: pre-wrap;
    word-break: break-word;
  }
  .msg-row.user .bubble {
    border-color: var(--blue);
    border-radius: 16px 6px 16px 16px;
    color: white;
    background: var(--blue);
  }
  .msg-row.ai .bubble { background: white; }
  .bubble.pending { color: var(--muted); font-style: italic; }
  #chat-input-area {
    display: flex;
    max-width: 760px;
    gap: 10px;
    margin-top: 14px;
    padding: 0;
    border: 0;
    background: transparent;
  }
  #chat-input { min-height: 48px; flex: 1; resize: vertical; }
  #quota-tip, #quota-empty {
    max-width: 760px;
    margin: 0 0 14px;
    padding: 10px 14px;
    border-radius: 9px;
    color: var(--muted);
    background: rgba(156, 232, 208, .22);
    font-size: 13px;
  }
  #quota-empty { color: #9b2d23; background: #fff0ee; }
</style>

<p class="eyebrow">A QUIET LINE TO DEEPSEEK</p>
<h1>与闲人对话</h1>
<p class="page-intro">不必组织成完整的问题。把刚冒出来的想法留在这里，我们从一句话开始。</p>

<% if (freeChatCount > 0) { %>
  <div id="quota-tip">剩余免费次数：<strong id="quota-num"><%= freeChatCount %></strong> 次</div>
<% } else if (hasOwnKey) { %>
  <div id="quota-tip">免费次数已用完，正在使用你自己的 API Key（不限次）</div>
<% } else { %>
  <div id="quota-empty">
    免费次数已用完。请前往 <a href="/settings">设置页</a> 填写你自己的 DeepSeek API Key 后继续使用。
  </div>
<% } %>

<div id="chat-box"></div>

<div id="chat-input-area">
  <textarea id="chat-input" rows="2" placeholder="和闲人聊点什么…（Enter 发送，Shift+Enter 换行）"></textarea>
  <button id="send-btn">发送</button>
</div>

<script src="/js/utils.js"></script>
<script>
  (function () {
    var box = document.getElementById('chat-box');
    var input = document.getElementById('chat-input');
    var sendBtn = document.getElementById('send-btn');
    var quotaNum = document.getElementById('quota-num');
    var sending = false;

    function addMessage(role, text, pending) {
      var row = document.createElement('div');
      row.className = 'msg-row ' + role;
      var bubble = document.createElement('div');
      bubble.className = 'bubble' + (pending ? ' pending' : '');
      // escapeHtml 来自 /js/utils.js，防止把用户/AI 文本当 HTML 解析
      bubble.innerHTML = escapeHtml(text);
      row.appendChild(bubble);
      box.appendChild(row);
      box.scrollTop = box.scrollHeight;
      return bubble;
    }

    function send() {
      if (sending) return;
      var text = input.value.trim();
      if (!text) return;

      addMessage('user', text);
      input.value = '';
      sending = true;
      sendBtn.disabled = true;
      var pendingBubble = addMessage('ai', '闲人正在输入…', true);

      fetch('/api/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ message: text })
      })
        .then(function (res) {
          if (res.status === 401) { window.location.href = '/login'; return null; }
          return res.json().then(function (data) { return { ok: res.ok, data: data }; });
        })
        .then(function (result) {
          if (!result) return;
          if (!result.ok) {
            pendingBubble.className = 'bubble';
            pendingBubble.textContent = '⚠️ ' + (result.data.error || '出错了');
            return;
          }
          pendingBubble.className = 'bubble';
          pendingBubble.innerHTML = escapeHtml(result.data.reply);
          // remaining 为 null 表示在用用户自己的 Key，不更新免费次数
          if (result.data.remaining !== null && quotaNum) {
            quotaNum.textContent = result.data.remaining;
          }
        })
        .catch(function (err) {
          pendingBubble.className = 'bubble';
          pendingBubble.textContent = '⚠️ 网络错误，请稍后再试';
          console.error(err);
        })
        .finally(function () {
          sending = false;
          sendBtn.disabled = false;
          box.scrollTop = box.scrollHeight;
        });
    }

    sendBtn.addEventListener('click', send);
    // Enter 发送，Shift+Enter 换行
    input.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        send();
      }
    });
  })();
</script>

<%- include('partials/footer') %>
